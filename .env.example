# Clé API Anthropic (Claude) — obligatoire pour générer les articles.
# Créez une clé sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Tag d'affiliation Amazon Associates — laissez vide tant que votre compte
# n'est pas approuvé. Les liens généreront alors des recherches Amazon
# classiques (sans commission). Une fois approuvé, renseignez votre tag
# (ex: monsite-21) : tous les articles utiliseront automatiquement le vrai
# lien d'affiliation au prochain déploiement, sans changement de code.
AMAZON_AFFILIATE_TAG=
