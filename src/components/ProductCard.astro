---
import AffiliateButton from './AffiliateButton.astro';

interface Props {
  name: string;
  affiliateUrl: string;
  imageUrl?: string;
  rating?: number;
  pros?: string[];
  cons?: string[];
}

const { name, affiliateUrl, imageUrl, rating, pros = [], cons = [] } = Astro.props;

const fullStars = rating ? Math.round(rating) : 0;
---

<article class:list={['product-card', { 'has-image': Boolean(imageUrl) }]}>
  {imageUrl && <img src={imageUrl} alt={name} loading="lazy" width="240" height="240" />}
  <div class="content">
    <h3>{name}</h3>
    {
      rating && (
        <p class="rating">
          <span class="stars" aria-hidden="true">
            {'★'.repeat(fullStars)}
            {'☆'.repeat(5 - fullStars)}
          </span>
          <span class="rating-value">{rating}/5</span>
        </p>
      )
    }
    <div class="pros-cons">
      {pros.length > 0 && (
        <div class="pros">
          <strong>Avantages</strong>
          <ul>
            {pros.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      )}
      {cons.length > 0 && (
        <div class="cons">
          <strong>Inconvénients</strong>
          <ul>
            {cons.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      )}
    </div>
    <AffiliateButton url={affiliateUrl} />
  </div>
</article>

<style>
  .product-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-block: 1.5rem;
  }

  .product-card.has-image {
    grid-template-columns: 200px 1fr;
  }

  .product-card img {
    object-fit: contain;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  h3 {
    margin-top: 0;
  }

  .rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.25rem 0 1rem;
  }

  .stars {
    color: var(--color-primary);
    letter-spacing: 0.05em;
  }

  .rating-value {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .pros-cons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-block: 1rem;
  }

  .pros-cons ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }

  .pros-cons li {
    padding-left: 1.3rem;
    position: relative;
    margin-bottom: 0.35rem;
    font-size: 0.92rem;
  }

  .pros li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-secondary);
    font-weight: 700;
  }

  .cons li::before {
    content: '✕';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .product-card.has-image {
      grid-template-columns: 1fr;
    }

    .pros-cons {
      grid-template-columns: 1fr;
    }
  }
</style>
